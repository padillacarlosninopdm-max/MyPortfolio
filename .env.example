# Copy these into your hosting dashboard (Vercel: Project > Settings >
# Environment Variables). NEVER put real keys in this repo.
BREVO_API_KEY=your-brevo-api-key-here
# Primary chat provider (tried first). Optional; falls back to Groq.
ITERACOMPUTE_API_KEY=your-iteracompute-api-key-here
# Secondary chat provider (fallback).
GROQ_API_KEY=your-groq-api-key-here
